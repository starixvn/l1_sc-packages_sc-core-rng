{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "lib": ["es5", "es6"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "allowJs": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "lib"]
}
