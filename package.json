{
    "name": "sc-core-rng",
    "version": "1.0.0",
    "description": "Secure RNG core functions for games using node:crypto",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "prepare": "node scripts/prepare.js",
        "prebuild": "npm run prepare",
        "build": "tsc",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "ci": "npm run lint && npm run test:ci && npm run build"
    },
    "keywords": [
        "rng",
        "crypto",
        "secure",
        "random",
        "shuffle"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^8.57.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.24",
        "@typescript-eslint/eslint-plugin": "^7.1.0",
        "@typescript-eslint/parser": "^7.1.0",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "jest-junit": "^16.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "ts-jest": "^29.1.2",
        "typescript": "^5.3.3"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-report.xml",
        "indent": 4
    }
}
